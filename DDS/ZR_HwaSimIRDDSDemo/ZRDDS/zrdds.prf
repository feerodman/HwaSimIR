DEFINES += _ZRDDSCPPINTERFACE

INCLUDEPATH += $$quote($$PWD/include/ZRDDSCoreInterface)
INCLUDEPATH += $$quote($$PWD/include/CPlusPlusInterface)
INCLUDEPATH += $$quote($$PWD/include/ZRDDSRPCInterface)
INCLUDEPATH += $$quote($$PWD/include/ZRDDSSecurityInterface)

CONFIG(debug, debug|release) {
     LIBS += -L$$quote($$PWD/lib) -lZRDDSCppzd -lws2_32 -lwsock32 -liphlpapi
}

CONFIG(release, debug|release) {
     LIBS += -L$$quote($$PWD/lib) -lZRDDSCppz -lws2_32 -lwsock32 -liphlpapi
}

