<zrdds_qos xmlns="http://www.omg.org/dds/">
  <qos_library name="default_lib">
    <qos_profile name="default_profile">
      <participantfactory_qos name="non_rio">
	    <property>
          <value>
		  <!-- UDP时延报文个数阈值 -->
            <element>
              <name>sysctl.global.net.delay_count</name>
              <value>10</value>
            </element>
			<!-- UDP时延时间 -->
            <element>
              <name>sysctl.global.net.delay_time</name>
              <value>200000</value>
            </element>
          </value>
        </property>
	  </participantfactory_qos>
      <participant_qos name="udp_dp">
        <discovery_config>
          <participant_liveliness_assert_period>
            <sec>3</sec>
            <nanosec>0</nanosec>
          </participant_liveliness_assert_period>
          <participant_liveliness_lease_duration>
            <sec>10</sec>
            <nanosec>0</nanosec>
          </participant_liveliness_lease_duration>
        </discovery_config>
        <usertraffic_receive_addresses>
          <addresses>
            <element>udpv4://default//0</element>
          </addresses>
        </usertraffic_receive_addresses>
         <receiver_thread_config>
          <kind>THREAD_PER_KIND</kind>
          <use_select>false</use_select>
          <receive_buffer_length>20971520</receive_buffer_length>
        </receiver_thread_config>
      </participant_qos>
      <participant_qos name="tcp_dp">
        <discovery_config>
          <participant_liveliness_assert_period>
            <sec>3</sec>
            <nanosec>0</nanosec>
          </participant_liveliness_assert_period>
          <participant_liveliness_lease_duration>
            <sec>10</sec>
            <nanosec>0</nanosec>
          </participant_liveliness_lease_duration>
        </discovery_config>
        <usertraffic_receive_addresses>
          <addresses>
            <element>tcpv4://default//0</element>
          </addresses>
        </usertraffic_receive_addresses>
      </participant_qos>
	   <datawriter_qos name="best_effort_writer">
        <reliability>
          <kind>BEST_EFFORT_RELIABILITY_QOS</kind>
        </reliability>
        <message_mode>
          <message_header_coalesce>true</message_header_coalesce>
        </message_mode>
		<property>
		  <value>
		   <!-- 负载对齐长度 -->
		    <element>
			  <name>sysctl.dw.align_payload</name>
			  <value>128</value>
			</element>
		   </value>
		</property>
      </datawriter_qos>
      <datareader_qos name="best_effort_reader">
	  	<reliability>
          <kind>BEST_EFFORT_RELIABILITY_QOS</kind>
        </reliability>
		<receive_addresses>
		  <addresses>
		    <element>udpv4://default//65536</element>
		  </addresses>
		</receive_addresses>
		<property>
		  <value>
		  <!-- 负载对齐长度 -->
		    <element>
			  <name>sysctl.dr.align_payload</name>
			  <value>128</value>
			</element>
			<!-- 底层接收缓冲区数量 -->
			<element>
			  <name>sysctl.dr.recv_buffer_count</name>
			  <value>2</value>
			</element>
			<!-- 数据接收缓冲区总大小 -->
			<element>
			  <name>sysctl.dr.max_sample_size</name>
			  <value>2100004</value>
			</element>
			<!-- 使用data_arrived回调函数 -->
			<element>
			  <name>sysctl.dr.use_data_arrived</name>
			  <value>true</value>
			</element>
		  </value>
		</property>
      </datareader_qos>
    </qos_profile>
  </qos_library>
</zrdds_qos>