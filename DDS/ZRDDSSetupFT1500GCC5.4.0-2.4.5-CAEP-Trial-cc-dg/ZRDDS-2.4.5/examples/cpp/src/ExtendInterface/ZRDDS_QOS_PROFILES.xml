<zrdds_qos xmlns="http://www.omg.org/dds/">
  <qos_library name="lib1">
    <qos_profile name="profile1">
      <participantfactory_qos name="app1">
        <rapidio_config>
          <controllers_config>
            <element>
              <rapidio_controller>0</rapidio_controller>
              <rapidio_address>0x10000000</rapidio_address>
              <receive_window_size>0x001000000</receive_window_size>
              <receive_subwindow_size>0x00400000</receive_subwindow_size>
            </element>
          </controllers_config>
        </rapidio_config>
      </participantfactory_qos>
      <participantfactory_qos name="app2" />
      <participantfactory_qos name="app3">
        <rapidio_config>
          <controllers_config>
            <element>
              <rapidio_controller>0</rapidio_controller>
              <rapidio_address>0x20000000</rapidio_address>
              <receive_window_size>0x001000000</receive_window_size>
              <receive_subwindow_size>0x00400000</receive_subwindow_size>
            </element>
          </controllers_config>
        </rapidio_config>
      </participantfactory_qos>
      <participant_qos name="rio_dp">
        <rapidio_controller>
          <controller_id>0</controller_id>
        </rapidio_controller>
        <usertraffic_receive_addresses>
          <addresses>
            <element>tcpv4://default//0</element>
          </addresses>
        </usertraffic_receive_addresses>
      </participant_qos>
      <participant_qos name="udp_dp">
        <usertraffic_receive_addresses>
          <addresses>
            <element>udpv4://239.255.0.2//0</element>
          </addresses>
        </usertraffic_receive_addresses>
      </participant_qos>
      <datawriter_qos name="AirTrack">
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <history>
          <kind>KEEP_ALL_HISTORY_QOS</kind>
        </history>
      </datawriter_qos>
      <datareader_qos name="AirTrack">
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
      </datareader_qos>
      <datawriter_qos name="SeaTrack">
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <history>
          <kind>KEEP_ALL_HISTORY_QOS</kind>
        </history>
      </datawriter_qos>
      <datareader_qos name="SeaTrack">
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
      </datareader_qos>
    </qos_profile>
  </qos_library>
</zrdds_qos>